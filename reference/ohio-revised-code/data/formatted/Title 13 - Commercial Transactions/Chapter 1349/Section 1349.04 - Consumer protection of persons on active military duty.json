{
  "glossary": [
    {
      "definition": "(1) \"Active duty\" means active duty pursuant to an executive order of the president of the United States, an act of the congress of the United States, or section 5919.29 or 5923.21 of the Revised Code.",
      "id": "1349.04-active-duty",
      "normalized": "active duty",
      "scope": "(A) As used in this section:",
      "section": "1349.04",
      "source_title": "Section 1349.04 - Consumer protection of persons on active military duty.",
      "source_url": "https://codes.ohio.gov/ohio-revised-code/section-1349.04",
      "term": "Active duty"
    },
    {
      "definition": "(2) \"Immediate family\" means a person's spouse residing in the person's household; brothers and sisters of the whole or half blood; children, including adopted children and stepchildren; parents; and grandparents.\n\n(B) The attorney general shall appoint a member of the staff of the consumer protection division of the attorney general's office to expedite cases or issues raised by a person, or the immediate family of the person, who is deployed on active duty, which cases or issues raised relate to section 317.322 , 1343.031 , 1349.02 , 1349.03 , 1713.60 , 1923.062 , 3313.64 , 3332.20 , 3345.53 , 3915.053 , 4933.12 , or 4933.121 of the Revised Code or to any other relevant section of the Revised Code regulating consumer protection.",
      "id": "1349.04-immediate-family",
      "normalized": "immediate family",
      "scope": "(A) As used in this section:",
      "section": "1349.04",
      "source_title": "Section 1349.04 - Consumer protection of persons on active military duty.",
