{
  "glossary": [
    {
      "definition": "(1) \"Criminal records check\" means any criminal records check conducted by the superintendent of the bureau of criminal identification and investigation in accordance with division (B) of this section.",
      "id": "109.572-criminal-records-check",
      "normalized": "criminal records check",
      "scope": "(G) As used in this section:",
      "section": "109.572",
      "source_title": "Section 109.572 - Criminal records check.",
      "source_url": "https://codes.ohio.gov/ohio-revised-code/section-109.572",
      "term": "Criminal records check"
    },
    {
      "definition": "(2) \"Minor drug possession offense\" has the same meaning as in section 2925.01 of the Revised Code.",
      "id": "109.572-minor-drug-possession-offense",
      "normalized": "minor drug possession offense",
      "scope": "(G) As used in this section:",
      "section": "109.572",
      "source_title": "Section 109.572 - Criminal records check.",
      "source_url": "https://codes.ohio.gov/ohio-revised-code/section-109.572",
      "term": "Minor drug possession offense"
    },
    {
      "definition": "(3) \"OVI or OVUAC violation\" means a violation of section 4511.19 of the Revised Code or a violation of an existing or former law of this state, any other state, or the United States that is substantially equivalent to section 4511.19 of the Revised Code.",
      "id": "109.572-ovi-or-ovuac-violation",
      "normalized": "ovi or ovuac violation",
      "scope": "(G) As used in this section:",
      "section": "109.572",
      "source_title": "Section 109.572 - Criminal records check.",
      "source_url": "https://codes.ohio.gov/ohio-revised-code/section-109.572",
      "term": "OVI or OVUAC violation"
    },
    {
      "definition": "(4) \"Registered private provider\" means a nonpublic school or entity registered with the department of education and workforce under section 3310.41 of the Revised Code to participate in the autism scholarship program or section 3310.58 of the Revised Code to participate in the Jon Peterson special needs scholarship program.\n\nLast updated January 16, 2026 at 2:43 PM",
      "id": "109.572-registered-private-provider",
      "normalized": "registered private provider",
      "scope": "(G) As used in this section:",
      "section": "109.572",
      "source_title": "Section 109.572 - Criminal records check.",
      "source_url": "https://codes.ohio.gov/ohio-revised-code/section-109.572",
      "term": "Registered private provider"
    }
  ],
