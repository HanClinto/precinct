      "source_url": "https://codes.ohio.gov/ohio-revised-code/section-4510.101",
      "term": "Drug of abuse"
    },
    {
      "definition": "(D) \"Complete amnesty\" means a waiver of reinstatement fees.",
      "id": "4510.101-complete-amnesty",
      "normalized": "complete amnesty",
      "scope": "As used in sections 4510.101 to 4510.108 of the Revised Code:",
