    {
      "definition": "(E) \"Driver's license or permit\" does not include a commercial driver's license or permit.",
      "id": "4510.101-driver-s-license-or-permit",
      "normalized": "driver's license or permit",
      "scope": "As used in sections 4510.101 to 4510.108 of the Revised Code:",
