    },
    {
      "definition": "(F) \"Indigent\" means a person who is a participant in any of the following programs:\n\n(1) The supplemental nutrition assistance program administered by the department of job and family services pursuant to section 5101.54 of the Revised Code;\n\n(2) The medicaid program pursuant to Chapter 5163. of the Revised Code;\n\n(3) The Ohio works first program administered by the department of job and family services pursuant to section 5107.10 of the Revised Code;\n\n(4) The supplemental security income program pursuant to 20 C.F.R. 416.1100;\n\n(5) The United States department of veterans affairs pension benefit program pursuant to 38 U.S.C. 1521.",
      "id": "4510.101-indigent",
      "normalized": "indigent",
      "scope": "As used in sections 4510.101 to 4510.108 of the Revised Code:",
      "section": "4510.101",
      "source_title": "Section 4510.101 - Definitions.",
      "source_url": "https://codes.ohio.gov/ohio-revised-code/section-4510.101",
      "term": "Indigent"
    },
    {
