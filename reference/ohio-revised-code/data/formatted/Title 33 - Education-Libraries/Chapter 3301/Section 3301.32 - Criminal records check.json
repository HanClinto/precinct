{
  "glossary": [
    {
      "definition": "(1) \"Applicant\" means a person who is under final consideration for appointment or employment in a position with a head start agency as a person responsible for the care, custody, or control of a child.",
      "id": "3301.32-applicant",
      "normalized": "applicant",
      "scope": "(G) As used in this section:",
      "section": "3301.32",
      "source_title": "Section 3301.32 - Criminal records check.",
      "source_url": "https://codes.ohio.gov/ohio-revised-code/section-3301.32",
      "term": "Applicant"
    },
    {
      "definition": "(2) \"Head start agency\" means an entity in this state that has been approved to be an agency for purposes of the \"Head Start Act,\" 95 State 489 (1981), 42 U.S.C. 9831, as amended.",
      "id": "3301.32-head-start-agency",
      "normalized": "head start agency",
      "scope": "(G) As used in this section:",
      "section": "3301.32",
      "source_title": "Section 3301.32 - Criminal records check.",
      "source_url": "https://codes.ohio.gov/ohio-revised-code/section-3301.32",
      "term": "Head start agency"
    },
    {
      "definition": "(3) \"Criminal records check\" has the same meaning as in section 109.572 of the Revised Code.",
      "id": "3301.32-criminal-records-check",
      "normalized": "criminal records check",
      "scope": "(G) As used in this section:",
      "section": "3301.32",
      "source_title": "Section 3301.32 - Criminal records check.",
      "source_url": "https://codes.ohio.gov/ohio-revised-code/section-3301.32",
      "term": "Criminal records check"
    },
    {
